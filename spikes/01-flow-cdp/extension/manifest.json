{
  "manifest_version": 3,
  "name": "ToolFlow Spike Connector",
  "version": "0.0.1",
  "description": "THROWAWAY spike: relays CDP commands from 127.0.0.1 to a Flow tab.",
  "background": { "service_worker": "background.js" },
  "permissions": ["debugger", "tabs", "downloads", "alarms", "scripting"],
  "host_permissions": ["https://flow.google.com/*", "https://labs.google/*"],
  "content_scripts": [{ "matches": ["https://flow.google.com/*"], "js": ["main-world.js"], "world": "MAIN", "run_at": "document_start" }]
}
