{
  "manifest_version": 3,
  "name": "ToolFlow Connector",
  "version": "0.1.0",
  "description": "Nối ToolFlow Desktop với tab Google Flow trên máy này (127.0.0.1).",
  "key": "",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["tabs", "scripting", "downloads", "alarms", "storage"],
  "host_permissions": ["https://flow.google.com/*", "https://chatgpt.com/*", "https://gemini.google.com/*"],
  "content_scripts": [
    { "matches": ["https://flow.google.com/*"], "js": ["epoch.js", "media-logic.js", "main-world.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://flow.google.com/*"], "js": ["settings-logic.js", "ref-logic.js", "page-ops.js"], "run_at": "document_start" },
    { "matches": ["https://chatgpt.com/*"], "js": ["gpt-logic.js", "gpt-ops.js"], "run_at": "document_idle" },
    { "matches": ["https://gemini.google.com/*"], "js": ["gem-logic.js", "gem-ops.js"], "run_at": "document_idle" }
  ]
}
